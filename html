<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sistema de Estacionamento</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    :root {
      --primary: #0d6efd;
      --success: #198754;
      --danger: #dc3545;
      --warning: #ffc107;
    }
    body { background: #f4f6f9; }
    .navbar { background: linear-gradient(135deg, #0d6efd, #0a58ca) !important; }
    .card-stat { border: none; border-radius: 12px; transition: transform .2s; }
    .card-stat:hover { transform: translateY(-4px); }
    .vaga-livre { background: #d1e7dd; border-color: #badbcc; }
    .vaga-ocupada { background: #f8d7da; border-color: #f5c2c7; }
    .vaga-pcd { background: #cff4fc; border-color: #b6effb; }
    .vaga-card { border-radius: 10px; cursor: pointer; transition: all .15s; }
    .vaga-card:hover { transform: scale(1.03); box-shadow: 0 4px 12px rgba(0,0,0,.15); }
    .section { display: none; }
    .section.active { display: block; }
    .placa { font-weight: 700; letter-spacing: 1px; font-family: monospace; }
  </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark shadow-sm">
  <div class="container">
    <a class="navbar-brand fw-bold" href="#"><i class="bi bi-p-square-fill"></i> Estacionamento</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link" href="#" onclick="show('dashboard')"><i class="bi bi-house"></i> Dashboard</a></li>
        <li class="nav-item"><a class="nav-link" href="#" onclick="show('entrada')"><i class="bi bi-box-arrow-in-right"></i> Entrada</a></li>
        <li class="nav-item"><a class="nav-link" href="#" onclick="show('saida')"><i class="bi bi-box-arrow-right"></i> Saída</a></li>
        <li class="nav-item"><a class="nav-link" href="#" onclick="show('vagas')"><i class="bi bi-grid"></i> Vagas</a></li>
        <li class="nav-item"><a class="nav-link" href="#" onclick="show('ativos')"><i class="bi bi-car-front"></i> No Pátio</a></li>
        <li class="nav-item"><a class="nav-link" href="#" onclick="show('clientes')"><i class="bi bi-people"></i> Clientes</a></li>
      </ul>
    </div>
  </div>
</nav>

<div class="container py-4">

  <!-- DASHBOARD -->
  <div id="dashboard" class="section active">
    <h4 class="mb-4"><i class="bi bi-speedometer2"></i> Dashboard</h4>
    <div class="row g-3 mb-4" id="stats"></div>
    <div class="card shadow-sm">
      <div class="card-header bg-white"><strong>Últimas entradas</strong></div>
      <div class="card-body p-0">
        <table class="table table-hover mb-0">
          <thead class="table-light"><tr><th>Vaga</th><th>Placa</th><th>Modelo</th><th>Cliente</th><th>Entrada</th></tr></thead>
          <tbody id="recentes"></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ENTRADA -->
  <div id="entrada" class="section">
    <h4 class="mb-4"><i class="bi bi-box-arrow-in-right"></i> Registrar Entrada</h4>
    <div class="card shadow-sm">
      <div class="card-body">
        <form id="formEntrada" onsubmit="registrarEntrada(event)">
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label">Placa</label>
              <input type="text" class="form-control text-uppercase" id="placaEntrada" placeholder="ABC1D23" required maxlength="8">
            </div>
            <div class="col-md-4">
              <label class="form-label">Modelo</label>
              <input type="text" class="form-control" id="modeloEntrada" placeholder="Gol, Civic...">
            </div>
            <div class="col-md-4">
              <label class="form-label">Tipo</label>
              <select class="form-select" id="tipoEntrada">
                <option value="carro">Carro</option>
                <option value="moto">Moto</option>
                <option value="suv">SUV</option>
                <option value="pcd">PCD</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Vaga</label>
              <select class="form-select" id="vagaEntrada" required></select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Cliente (opcional)</label>
              <input type="text" class="form-control" id="clienteEntrada" placeholder="Nome do cliente">
            </div>
          </div>
          <button type="submit" class="btn btn-success mt-3"><i class="bi bi-check-lg"></i> Registrar Entrada</button>
        </form>
      </div>
    </div>
  </div>

  <!-- SAÍDA -->
  <div id="saida" class="section">
    <h4 class="mb-4"><i class="bi bi-box-arrow-right"></i> Registrar Saída</h4>
    <div class="card shadow-sm">
      <div class="card-body">
        <form id="formSaida" onsubmit="registrarSaida(event)">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Placa</label>
              <input type="text" class="form-control text-uppercase" id="placaSaida" placeholder="ABC1D23" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Forma de Pagamento</label>
              <select class="form-select" id="pagamentoSaida">
                <option>Dinheiro</option>
                <option>Pix</option>
                <option>Cartão</option>
                <option>Isento (PCD)</option>
              </select>
            </div>
          </div>
          <button type="submit" class="btn btn-danger mt-3"><i class="bi bi-box-arrow-right"></i> Registrar Saída</button>
        </form>
        <div id="resultadoSaida" class="mt-3"></div>
      </div>
    </div>
  </div>

  <!-- VAGAS -->
  <div id="vagas" class="section">
    <h4 class="mb-4"><i class="bi bi-grid"></i> Mapa de Vagas</h4>
    <div class="row g-3" id="listaVagas"></div>
  </div>

  <!-- ATIVOS -->
  <div id="ativos" class="section">
    <h4 class="mb-4"><i class="bi bi-car-front"></i> Veículos no Pátio</h4>
    <div class="card shadow-sm">
      <div class="card-body p-0">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr><th>Vaga</th><th>Placa</th><th>Modelo</th><th>Tipo</th><th>Entrada</th><th>Tempo</th><th>Valor estimado</th></tr>
          </thead>
          <tbody id="tabelaAtivos"></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- CLIENTES -->
  <div id="clientes" class="section">
    <h4 class="mb-4"><i class="bi bi-people"></i> Clientes</h4>
    <div class="card shadow-sm mb-3">
      <div class="card-body">
        <form class="row g-2" onsubmit="adicionarCliente(event)">
          <div class="col-md-4"><input class="form-control" id="nomeCliente" placeholder="Nome" required></div>
          <div class="col-md-3"><input class="form-control" id="cpfCliente" placeholder="CPF (opcional)"></div>
          <div class="col-md-3"><input class="form-control" id="telCliente" placeholder="Telefone"></div>
          <div class="col-md-2"><button class="btn btn-primary w-100">Adicionar</button></div>
        </form>
      </div>
    </div>
    <div class="card shadow-sm">
      <div class="card-body p-0">
        <table class="table mb-0">
          <thead class="table-light"><tr><th>Nome</th><th>CPF</th><th>Telefone</th><th></th></tr></thead>
          <tbody id="tabelaClientes"></tbody>
        </table>
      </div>
    </div>
  </div>

</div>

<footer class="text-center py-3 text-muted small">
  Sistema de Estacionamento &copy; 2026 — Versão HTML (localStorage)
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
const TARIFAS = {
  carro: { primeira: 12, adicional: 8, tolerancia: 15 },
  moto:  { primeira: 6,  adicional: 4, tolerancia: 15 },
  suv:   { primeira: 15, adicional: 10, tolerancia: 15 },
  pcd:   { primeira: 0,  adicional: 0, tolerancia: 15 }
};

function load() {
  const data = JSON.parse(localStorage.getItem('estacionamento') || 'null');
  if (data) return data;
  // Dados iniciais
  return {
    vagas: [
      {id:1, numero:'A01', setor:'A', tipo:'carro', status:'livre'},
      {id:2, numero:'A02', setor:'A', tipo:'carro', status:'livre'},
      {id:3, numero:'A03', setor:'A', tipo:'carro', status:'livre'},
      {id:4, numero:'A04', setor:'A', tipo:'carro', status:'livre'},
      {id:5, numero:'A05', setor:'A', tipo:'carro', status:'livre'},
      {id:6, numero:'B01', setor:'B', tipo:'moto', status:'livre'},
      {id:7, numero:'B02', setor:'B', tipo:'moto', status:'livre'},
      {id:8, numero:'B03', setor:'B', tipo:'moto', status:'livre'},
      {id:9, numero:'C01', setor:'C', tipo:'suv', status:'livre'},
      {id:10,numero:'C02', setor:'C', tipo:'suv', status:'livre'},
      {id:11,numero:'P01', setor:'PCD', tipo:'pcd', status:'livre'},
      {id:12,numero:'P02', setor:'PCD', tipo:'pcd', status:'livre'}
    ],
    ativos: [],
    historico: [],
    clientes: []
  };
}

function save(data) {
  localStorage.setItem('estacionamento', JSON.stringify(data));
}

function show(id) {
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  if (id === 'dashboard') renderDashboard();
  if (id === 'entrada') popularVagasLivres();
  if (id === 'vagas') renderVagas();
  if (id === 'ativos') renderAtivos();
  if (id === 'clientes') renderClientes();
}

function agora() {
  return new Date().toLocaleString('pt-BR');
}

function calcularValor(minutos, tipo) {
  const t = TARIFAS[tipo] || TARIFAS.carro;
  if (minutos <= t.tolerancia) return 0;
  const horas = Math.ceil(minutos / 60);
  if (horas <= 1) return t.primeira;
  return t.primeira + (horas - 1) * t.adicional;
}

function minutosEntre(entradaStr) {
  const entrada = new Date(entradaStr);
  return Math.floor((Date.now() - entrada) / 60000);
}

function popularVagasLivres() {
  const data = load();
  const sel = document.getElementById('vagaEntrada');
  const tipo = document.getElementById('tipoEntrada').value;
  sel.innerHTML = '<option value="">Selecione...</option>';
  data.vagas
    .filter(v => v.status === 'livre' && (v.tipo === tipo || tipo === 'pcd'))
    .forEach(v => {
      sel.innerHTML += `<option value="${v.id}">${v.numero} (${v.setor} - ${v.tipo})</option>`;
    });
}

document.getElementById('tipoEntrada')?.addEventListener('change', popularVagasLivres);

function registrarEntrada(e) {
  e.preventDefault();
  const data = load();
  const placa = document.getElementById('placaEntrada').value.toUpperCase().replace(/[^A-Z0-9]/g,'');
  const modelo = document.getElementById('modeloEntrada').value || '-';
  const tipo = document.getElementById('tipoEntrada').value;
  const vagaId = parseInt(document.getElementById('vagaEntrada').value);
  const cliente = document.getElementById('clienteEntrada').value || 'Avulso';

  if (!/^[A-Z]{3}[0-9]{4}$|^[A-Z]{3}[0-9][A-Z][0-9]{2}$/.test(placa)) {
    alert('Placa inválida! Use ABC1234 ou ABC1D23');
    return;
  }
  if (data.ativos.some(a => a.placa === placa)) {
    alert('Esta placa já está no pátio!');
    return;
  }
  const vaga = data.vagas.find(v => v.id === vagaId);
  if (!vaga || vaga.status !== 'livre') {
    alert('Vaga indisponível');
    return;
  }

  vaga.status = 'ocupada';
  data.ativos.push({
    id: Date.now(),
    vagaId, vaga: vaga.numero, placa, modelo, tipo, cliente,
    entrada: new Date().toISOString()
  });
  save(data);
  alert(`Entrada registrada!\nPlaca ${placa} na vaga ${vaga.numero}`);
  document.getElementById('formEntrada').reset();
  show('dashboard');
}

function registrarSaida(e) {
  e.preventDefault();
  const data = load();
  const placa = document.getElementById('placaSaida').value.toUpperCase().replace(/[^A-Z0-9]/g,'');
  const ativo = data.ativos.find(a => a.placa === placa);
  if (!ativo) {
    alert('Nenhum veículo ativo encontrado com esta placa.');
    return;
  }
  const mins = minutosEntre(ativo.entrada);
  const valor = calcularValor(mins, ativo.tipo);
  const pagamento = document.getElementById('pagamentoSaida').value;

  data.vagas.find(v => v.id === ativo.vagaId).status = 'livre';
  data.ativos = data.ativos.filter(a => a.placa !== placa);
  data.historico.push({...ativo, saida: new Date().toISOString(), valor, pagamento});
  save(data);

  document.getElementById('resultadoSaida').innerHTML = `
    <div class="alert alert-success">
      <strong>Saída registrada!</strong><br>
      Placa: <span class="placa">${placa}</span> | Tempo: ${mins} min<br>
      Valor: <strong>R$ ${valor.toFixed(2)}</strong> (${pagamento})
    </div>`;
  document.getElementById('formSaida').reset();
}

function renderDashboard() {
  const data = load();
  const livres = data.vagas.filter(v => v.status === 'livre').length;
  const ocupadas = data.vagas.filter(v => v.status === 'ocupada').length;
  const faturamento = data.historico
    .filter(h => new Date(h.saida).toDateString() === new Date().toDateString())
    .reduce((s,h) => s + h.valor, 0);

  document.getElementById('stats').innerHTML = `
    <div class="col-md-3"><div class="card card-stat bg-success text-white"><div class="card-body"><h6>Livres</h6><h2>${livres}</h2></div></div></div>
    <div class="col-md-3"><div class="card card-stat bg-danger text-white"><div class="card-body"><h6>Ocupadas</h6><h2>${ocupadas}</h2></div></div></div>
    <div class="col-md-3"><div class="card card-stat bg-primary text-white"><div class="card-body"><h6>No Pátio</h6><h2>${data.ativos.length}</h2></div></div></div>
    <div class="col-md-3"><div class="card card-stat bg-warning text-dark"><div class="card-body"><h6>Faturamento Hoje</h6><h2>R$ ${faturamento.toFixed(2)}</h2></div></div></div>`;

  const rec = data.ativos.slice(-5).reverse();
  document.getElementById('recentes').innerHTML = rec.length
    ? rec.map(a => `<tr><td>${a.vaga}</td><td class="placa">${a.placa}</td><td>${a.modelo}</td><td>${a.cliente}</td><td>${new Date(a.entrada).toLocaleString('pt-BR')}</td></tr>`).join('')
    : '<tr><td colspan="5" class="text-center text-muted">Nenhum veículo no pátio</td></tr>';
}

function renderVagas() {
  const data = load();
  document.getElementById('listaVagas').innerHTML = data.vagas.map(v => {
    const cls = v.status === 'livre' ? 'vaga-livre' : 'vaga-ocupada';
    const extra = v.tipo === 'pcd' ? ' vaga-pcd' : '';
    return `<div class="col-6 col-md-3 col-lg-2">
      <div class="card vaga-card ${cls}${extra} text-center p-3">
        <strong>${v.numero}</strong>
        <small>${v.setor} · ${v.tipo}</small>
        <span class="badge ${v.status==='livre'?'bg-success':'bg-danger'} mt-1">${v.status}</span>
      </div>
    </div>`;
  }).join('');
}

function renderAtivos() {
  const data = load();
  document.getElementById('tabelaAtivos').innerHTML = data.ativos.length
    ? data.ativos.map(a => {
        const mins = minutosEntre(a.entrada);
        const valor = calcularValor(mins, a.tipo);
        return `<tr>
          <td>${a.vaga}</td>
          <td class="placa">${a.placa}</td>
          <td>${a.modelo}</td>
          <td>${a.tipo}</td>
          <td>${new Date(a.entrada).toLocaleString('pt-BR')}</td>
          <td>${mins} min</td>
          <td>R$ ${valor.toFixed(2)}</td>
        </tr>`;
      }).join('')
    : '<tr><td colspan="7" class="text-center text-muted">Nenhum veículo no pátio</td></tr>';
}

function adicionarCliente(e) {
  e.preventDefault();
  const data = load();
  data.clientes.push({
    id: Date.now(),
    nome: document.getElementById('nomeCliente').value,
    cpf: document.getElementById('cpfCliente').value || '-',
    telefone: document.getElementById('telCliente').value || '-'
  });
  save(data);
  document.getElementById('nomeCliente').value = '';
  document.getElementById('cpfCliente').value = '';
  document.getElementById('telCliente').value = '';
  renderClientes();
}

function renderClientes() {
  const data = load();
  document.getElementById('tabelaClientes').innerHTML = data.clientes.length
    ? data.clientes.map(c => `<tr><td>${c.nome}</td><td>${c.cpf}</td><td>${c.telefone}</td><td><button class="btn btn-sm btn-outline-danger" onclick="removerCliente(${c.id})">Remover</button></td></tr>`).join('')
    : '<tr><td colspan="4" class="text-center text-muted">Nenhum cliente cadastrado</td></tr>';
}

function removerCliente(id) {
  const data = load();
  data.clientes = data.clientes.filter(c => c.id !== id);
  save(data);
  renderClientes();
}

// Inicialização
renderDashboard();
popularVagasLivres();
</script>
</body>
</html>
